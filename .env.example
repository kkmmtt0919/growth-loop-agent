# ============================================================
# 成长回路（Growth Loop）环境变量模板
# 本地开发：cp .env.example .env.local 后按需填
# 部署（Docker/服务器）：cp .env.example .env
# 部署前校验：node scripts/check-env.mjs prod
# ============================================================

# Optional LLM provider configuration. Never commit real secrets.
# `demo` is safe for local preview. For a real model, inject a managed profile
# with llm_config.ps1 so the provider, endpoint, model, and key stay out of source control.
# 生产部署（Docker 一键或云服务器）推荐配置真实模型：LLM_PROVIDER 支持 demo | openai | deepseek | glm
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# PostgreSQL connection string — the ONLY thing that changes when migrating.
# MVP: Supabase pooler URL (Settings → Database → Connection string → Pooler)
# Production: Tencent Cloud PG URL. Business code does not change.
# Example: postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres?sslmode=require
# Docker Compose 一键（docker-compose.yml 默认）会覆盖为本机 db 服务，无需在此填。
DATABASE_URL=

# JWT signing secret for email/password auth. MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# System credential for scheduled tasks (production cron / SCF calls POST /api/evening-report).
# Only set on the server; never expose to clients.
CRON_SECRET=

# Demo seed on registration. Default true (dev/demo friendly).
# Set to "false" in production so new users start empty and go through onboarding.
ENABLE_DEMO_SEED=true

# Fill these only in a deployment secret store after the official account is approved.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# ---- 部署必填 4 键 ----
# 非 demo 部署（node scripts/check-env.mjs prod）至少需要：
#   1. DATABASE_URL   2. JWT_SECRET   3. CRON_SECRET   4. LLM_API_KEY（缺则规则回退，仅警告）
# 其余保持默认即可起步。

