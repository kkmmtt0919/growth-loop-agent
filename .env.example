# Optional LLM provider configuration. Never commit real secrets.
# `demo` is safe for local preview. For a real model, inject a managed profile
# with llm_config.ps1 so the provider, endpoint, model, and key stay out of source control.
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# PostgreSQL connection string — the ONLY thing that changes when migrating.
# MVP: Supabase pooler URL (Settings → Database → Connection string → Pooler)
# Production: Tencent Cloud PG URL. Business code does not change.
# Example: postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# JWT signing secret for email/password auth. MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Fill these only in a deployment secret store after the official account is approved.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
